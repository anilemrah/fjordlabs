---
import Base from "./Base.astro";
import ProductCallout from "../components/ProductCallout.astro";
import AppCallout from "../components/AppCallout.astro";
import { getProduct } from "../data/products";
import { getApp } from "../data/apps";

interface Props {
  title: string;
  description: string;
  game: string;
  gameTitle: string;
  category: string;
  product?: string;
  /** Slug from apps.ts — only where the app genuinely helps with the article's topic. */
  app?: string;
  publishDate?: string;
  updatedDate?: string;
}

const {
  title,
  description,
  game,
  gameTitle,
  category,
  product,
  app,
  publishDate,
  updatedDate,
} = Astro.props;

const relatedProduct = product ? getProduct(product) : undefined;
const relatedApp = app ? getApp(app) : undefined;

const siteUrl = "https://www.fjord-labs.com";
const image = relatedProduct?.image ?? `${siteUrl}/images/og-default.jpg`;

// Sibling articles are read from the page files themselves, so this list can't
// drift from what's published. Without it an article links only to its hub,
// and Google rates pages with that few internal links as not worth crawling.
const articleSources = import.meta.glob<string>("../pages/games/*/*.astro", {
  query: "?raw",
  import: "default",
  eager: true,
});
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const moreArticles = Object.entries(articleSources)
  .map(([path, source]) => {
    const tag = source.match(/<Article\s([\s\S]*?)\n>/)?.[1];
    const prop = (name: string) => tag?.match(new RegExp(`\\b${name}="([^"]*)"`))?.[1];
    const [, folder, file] = path.match(/games\/([^/]+)\/([^/]+)\.astro$/)!;
    return { folder, href: `/games/${folder}/${file}/`, title: prop("title"), category: prop("category") };
  })
  .filter((a) => a.folder === game && a.title && a.href.replace(/\/$/, "") !== currentPath)
  .sort((a, b) => Number(b.category === category) - Number(a.category === category));
---

<Base
  title={`${title} | Fjord Labs`}
  description={description}
  ogImage={relatedProduct?.image}
  type="article"
>
  <article class="max-w-3xl mx-auto px-6 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-bark/40 mb-8">
      <a href="/" class="hover:text-clay transition-colors">Home</a>
      <span>/</span>
      <a href={`/games/${game}/`} class="hover:text-clay transition-colors"
        >{gameTitle}</a
      >
      <span>/</span>
      <span class="text-bark/60">{category}</span>
    </nav>

    <!-- Article Header -->
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span
          class="px-3 py-1 bg-clay/10 text-clay text-xs font-semibold rounded-full uppercase tracking-wide"
        >
          {category}
        </span>
        <span
          class="px-3 py-1 bg-forest/10 text-forest text-xs font-semibold rounded-full"
        >
          {gameTitle}
        </span>
      </div>
      <h1 class="text-3xl md:text-4xl font-heading font-bold text-bark mb-4 leading-tight">
        {title}
      </h1>
      <p class="text-lg text-bark/50">
        {description}
      </p>
      {
        publishDate && (
          <time class="text-sm text-bark/30 mt-3 block">
            {publishDate}{updatedDate && ` · Updated ${updatedDate}`}
          </time>
        )
      }
    </header>

    <!-- Article Body -->
    <div class="prose-article">
      <slot />
    </div>

    <!-- Product Callout (injected from frontmatter) -->
    {relatedProduct && <ProductCallout product={relatedProduct} />}
    {relatedApp && <AppCallout app={relatedApp} />}

    <!-- More articles for the same game -->
    <div class="mt-16 pt-8 border-t border-bark/10">
      {
        moreArticles.length > 0 && (
          <section class="mb-8">
            <h2 class="text-xl font-heading font-bold text-bark mb-4">
              More {gameTitle} articles
            </h2>
            <ul class="grid sm:grid-cols-2 gap-3">
              {moreArticles.map((a) => (
                <li>
                  <a
                    href={a.href}
                    class="group flex h-full flex-col gap-2 p-4 bg-white rounded-xl border border-bark/5 hover:border-clay/20 transition-colors"
                  >
                    <span class="text-[11px] font-semibold uppercase tracking-wide text-clay">
                      {a.category}
                    </span>
                    <span class="font-heading font-semibold text-bark leading-snug group-hover:text-clay transition-colors">
                      {a.title}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      <a
        href={`/games/${game}/`}
        class="inline-flex items-center gap-2 text-clay hover:text-clay-dark transition-colors font-medium"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
         All {gameTitle} guides and upgrades
      </a>
    </div>
  </article>

  <!-- JSON-LD Structured Data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description: description,
      image: image,
      mainEntityOfPage: new URL(Astro.url.pathname, siteUrl).toString(),
      author: {
        "@type": "Organization",
        name: "Fjord Labs",
        url: siteUrl,
      },
      publisher: {
        "@type": "Organization",
        name: "Fjord Labs",
        logo: `${siteUrl}/images/fjordlabsicon.png`,
      },
      ...(publishDate && { datePublished: publishDate }),
      ...(updatedDate && { dateModified: updatedDate }),
    })}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
        { "@type": "ListItem", position: 2, name: gameTitle, item: `${siteUrl}/games/${game}/` },
        { "@type": "ListItem", position: 3, name: title },
      ],
    })}
  />
</Base>
