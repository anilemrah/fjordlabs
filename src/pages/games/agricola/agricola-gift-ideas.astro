import GiftPick from "../../../components/GiftPick.astro";
import GiftFaq from "../../../components/GiftFaq.astro";
import ChristmasDelivery from "../../../components/ChristmasDelivery.astro";

const faqs = [
  {
    q: "What do you get an Agricola fan for Christmas?",
    a: "An upgrade for the copy they already play. A 3D-printed resource bundle replaces the cubes and discs with sculpted wood, clay, reed, stone, grain and pumpkins, and they see it on their farm every round.",
  },
  {
    q: "What's a good small gift for an Agricola player?",
    a: "Pumpkin or reed tokens. Each set is ten pieces, they're inexpensive, and they fit in a stocking. Sheep tokens are the next step up, and they suit a game that's all about fencing pastures.",
  },
  {
    q: "Which edition of Agricola should I buy as a gift?",
    a: "The revised edition. It has cleaner iconography, better components and a clearer rulebook than the original. Suggest the family variant for the first game, and the full game with Occupations and Improvements once they know the basics.",
  },
  {
    q: "Will an Agricola gift from Fjord Labs arrive before Christmas?",
    a: "Physical pieces are posted from Sweden within 3–5 business days. In mid-November, Etsy estimated 7–13 days to delivery in Europe and the UK and 9–15 days to the US, so order early in December at the latest, and earlier for the US.",
  },
];
---

<Article
  title="Agricola Gift Ideas: 7 Christmas Gifts for Agricola Fans (2026)"
  description="Christmas gifts for someone who loves Agricola: a full set of sculpted resources, sheep for their pastures, pumpkin and reed tokens for a stocking, and trays that make a long game smoother."
  game="agricola"
  gameTitle="Agricola"
  category="Guide"
  publishDate="2026-11-19"
>
  <p>
    Agricola players spend two hours looking at their own farm, so the best gifts
    are the pieces on it. Swapping cubes and discs for sculpted wood, clay, reed,
    stone and grain turns the supply into a farmyard, and it's an upgrade they'll
    notice every round. Here are seven gifts, from a stocking stuffer to the full set.
  </p>

  <KeyTakeaway answer="The best gift for an Agricola fan is a 3D-printed resource bundle: sculpted wood, clay, reed, stone, grain and pumpkins instead of cubes and discs. Sheep tokens are the best small extra, pumpkin or reed sets fit in a stocking, and if they don't own the game yet, give the revised edition." />

  <h2>The upgrade they'll see every round</h2>
  <p>
    Every action in Agricola moves resources from the supply onto your farm: wood and
    clay for rooms, reed for the roof, grain and vegetables for the harvest. In the box
    they're plain cubes and discs.
  </p>

  <GiftPick
    slug="agricola-resource-tokens"
    label="Our top pick"
    note="Sculpted wood, clay, reed, stone, grain and pumpkins in place of the cubes and discs. The supply reads like a farmyard, and the harvest, when everyone's counting grain to feed their family, feels like one."
  />

  <h2>Sheep for the pastures</h2>

  <GiftPick
    slug="sheep-tokens"
    label="Best for animal lovers"
    note="Ten little sheep in white or black-and-white. Agricola is built around fencing pastures for sheep, boar and cattle, and these are the pieces people pick up and don't want to put down. A big flock may need two sets."
  />

  <h2>Small gifts and stocking stuffers</h2>

  <GiftPick
    slug="pumpkin-tokens"
    label="Best small gift"
    note="Ten tiny pumpkins for the vegetable fields. The bright orange reads from across the table, and a pumpkin patch growing on the farm is the detail that gets a smile."
  />
  <GiftPick
    slug="rice-reed-tokens"
    note="Ten white sheaves for reed, the resource everyone forgets they need for rooms and renovations. They're neutral enough to work as rice in other farming games too."
  />

  <h2>For a smoother game night</h2>
  <p>
    A full game of Agricola takes 90 to 150 minutes, with a hand of Occupations and
    Improvements and a personal supply that grows all game. Two things help:
  </p>

  <GiftPick
    slug="card-holder"
    note="A tiered stand that keeps their Occupations and Improvements upright and readable, instead of fanned in one hand for two hours."
  />
  <GiftPick
    slug="universal-player-tray"
    note="Resource wells and a card rail in one tray, so each player's supply has a home next to their farm board. It works with the rest of their shelf too."
  />

  <h2>If they don't own Agricola yet</h2>
  <p>
    Then the game itself is the gift. Get the revised edition, with its cleaner
    iconography, better components and a rulebook that explains itself, and suggest
    the family variant for the first game. It plays one to four, and our
    <a href="/games/agricola/is-agricola-worth-it/">honest review of Agricola</a> rates
    the solo campaign highly. <a href="/games/agricola/how-to-play-agricola/">How to play
    Agricola</a> gets a new farmer started on Christmas Day.
  </p>
  <p>
    For a couple who mostly play with two, <em>Agricola: All Creatures Big and Small</em> is
    Uwe Rosenberg's two-player version about the animal side of the farm, and it plays
    in about half an hour.
  </p>

  <h2>Which Agricola gift fits?</h2>

