        </tr>
      </thead>
      <tbody>
        <tr class="border-t border-bark/5"><td class="p-3">Play Agricola regularly</td><td class="p-3 font-semibold">The resource token bundle</td></tr>
        <tr class="border-t border-bark/5"><td class="p-3">Love the animals</td><td class="p-3 font-semibold">Sheep tokens</td></tr>
        <tr class="border-t border-bark/5"><td class="p-3">Need a small or stocking gift</td><td class="p-3 font-semibold">Pumpkin or reed tokens</td></tr>
        <tr class="border-t border-bark/5"><td class="p-3">Play the full game with all the cards</td><td class="p-3 font-semibold">A card holder</td></tr>
        <tr class="border-t border-bark/5"><td class="p-3">Don't own it yet</td><td class="p-3 font-semibold">Agricola (revised edition)</td></tr>
        <tr class="border-t border-bark/5"><td class="p-3">Mostly play with two</td><td class="p-3 font-semibold">All Creatures Big and Small</td></tr>
      </tbody>
    </table>
  </ComparisonTable>

