---
import Base from "../../../layouts/Base.astro";
import GameBoxImage from "../../../components/GameBoxImage.astro";
import ProductCard from "../../../components/ProductCard.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import { getProductsByGame } from "../../../data/products";
import { getGame } from "../../../data/games";

const game = getGame("agricola")!;
const agricolaProducts = getProductsByGame("agricola");

const articles = {
  rules: [
    {
      title: "How to Play Agricola: Complete Rules for New Players",
      description: "Fourteen rounds, six harvests, and one question that never goes away — can you feed everyone?",
      href: "/games/agricola/how-to-play-agricola/",
    },
    {
      title: "Agricola Feeding Rules: How to Never Take a Begging Card",
      description: "Two food per family member, every harvest. Here's how to plan for it instead of panicking.",
      href: "/games/agricola/agricola-feeding-your-family/",
    },
  ],
  strategy: [
    {
      title: "Agricola Strategy for Beginners: Your First Five Rounds",
      description: "Family growth is the engine. Everything else is decoration until you understand why.",
      href: "/games/agricola/agricola-beginner-strategy/",
    },
  ],
  guides: [
    {
      title: "Is Agricola Worth It in 2026? An Honest Review",
      description: "Nearly twenty years old and still brutal. Does it deserve shelf space today?",
      href: "/games/agricola/is-agricola-worth-it/",
    },
  ],
};
---

<Base
  title="Agricola — Rules, Feeding, Strategy & Accessories | Fjord Labs"
  description="Everything you need for Agricola: complete rules, the feeding phase explained, beginner strategy for your first five rounds, and 3D-printed resource tokens."
>
  <section class="py-16 md:py-20 px-6 bg-sand/50 border-b border-bark/5">
    <div class="max-w-4xl mx-auto">
      <nav class="flex items-center gap-2 text-sm text-bark/40 mb-6">
        <a href="/" class="hover:text-clay transition-colors">Home</a>
        <span>/</span>
        <span class="text-bark/60">Agricola</span>
      </nav>

      <div class="flex flex-col sm:flex-row gap-6 items-start">
        <GameBoxImage game={game} />
        <div>
          <h1 class="text-3xl md:text-5xl font-heading font-bold text-bark mb-4 leading-tight">
            Agricola
          </h1>
          <p class="text-lg text-bark/50 max-w-2xl leading-relaxed mb-6">
            {game.heroDescription}
          </p>

          <div class="flex flex-wrap gap-6 text-sm text-bark/40">
            <div><span class="font-semibold text-bark/60">Players:</span> {game.playerCount}</div>
            <div><span class="font-semibold text-bark/60">Play Time:</span> {game.playTime}</div>
            <div><span class="font-semibold text-bark/60">Complexity:</span> {game.complexity}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-bark mb-2">Rules Clarifications</h2>
      <p class="text-bark/40 mb-8">The rulebook is dense. These are the parts that actually decide games.</p>
      <div class="grid md:grid-cols-2 gap-6">
        {articles.rules.map((a) => (
          <ArticleCard title={a.title} description={a.description} href={a.href} category="Rules" />
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 px-6 bg-sand/30">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-bark mb-2">Strategy</h2>
      <p class="text-bark/40 mb-8">Where to spend your first, precious few actions.</p>
      <div class="grid md:grid-cols-2 gap-6">
        {articles.strategy.map((a) => (
          <ArticleCard title={a.title} description={a.description} href={a.href} category="Strategy" />
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-bark mb-2">Guides & Reviews</h2>
      <p class="text-bark/40 mb-8">Buying advice and honest takes.</p>
      <div class="grid md:grid-cols-2 gap-6">
        {articles.guides.map((a) => (
          <ArticleCard title={a.title} description={a.description} href={a.href} category="Guide" />
        ))}
      </div>
    </div>
  </section>

  {agricolaProducts.length > 0 && (
    <section class="py-14 px-6 bg-sand/50 border-t border-bark/5">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl font-heading font-bold text-bark mb-2">Agricola Accessories</h2>
        <p class="text-bark/40 mb-8">Sculpted grain, vegetables and reed to replace the cardboard chits.</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {agricolaProducts.map((product) => <ProductCard product={product} />)}
        </div>
      </div>
    </section>
  )}
</Base>
