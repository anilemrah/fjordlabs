---
import Base from "../../../layouts/Base.astro";
import ProductCard from "../../../components/ProductCard.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import { getProductsByGame } from "../../../data/products";
import { getGame } from "../../../data/games";

const game = getGame("wingspan-pocket")!;
const pocketProducts = getProductsByGame("wingspan-pocket");

const articles = {
  rules: [
    {
      title: "Wingspan Pocket vs Wingspan: Every Difference Explained",
      description:
        "No birdfeeder, no habitats, no rounds — how the pocket edition actually plays.",
      href: "/games/wingspan-pocket/wingspan-pocket-vs-wingspan/",
    },
  ],
  guides: [
    {
      title: "Is Wingspan Pocket Worth It? An Honest First Look",
      description:
        "Should Wingspan fans buy the pocket edition? Who it's for — and who should skip it.",
      href: "/games/wingspan-pocket/is-wingspan-pocket-worth-it/",
    },
  ],
};
---

<Base
  title="Wingspan Pocket — Rules, Guides & Accessories | Fjord Labs"
  description="Everything about Wingspan Pocket (2026): how it differs from Wingspan, whether it's worth buying, and our 3D-printed insert made for the new compact edition."
>
  <section class="py-16 md:py-20 px-6 bg-sand/50 border-b border-bark/5">
    <div class="max-w-4xl mx-auto">
      <nav class="flex items-center gap-2 text-sm text-bark/40 mb-6">
        <a href="/" class="hover:text-clay transition-colors">Home</a>
        <span>/</span>
        <span class="text-bark/60">Wingspan Pocket</span>
      </nav>

      <div class="flex flex-col sm:flex-row gap-6 items-start">
        <img src={game.image} alt={game.title} class="w-32 h-32 rounded-2xl object-cover border border-bark/10 shrink-0" />
        <div>
          <div class="inline-flex items-center gap-2 mb-3 px-3 py-1 rounded-full bg-clay/10 text-clay text-xs font-bold">
            ✨ New Release — July 2026
          </div>
          <h1 class="text-3xl md:text-5xl font-heading font-bold text-bark mb-4 leading-tight">
            Wingspan Pocket
          </h1>
          <p class="text-lg text-bark/50 max-w-2xl leading-relaxed mb-6">
            {game.heroDescription}
          </p>

          <div class="flex flex-wrap gap-6 text-sm text-bark/40">
            <div><span class="font-semibold text-bark/60">Players:</span> {game.playerCount}</div>
            <div><span class="font-semibold text-bark/60">Play Time:</span> {game.playTime}</div>
            <div><span class="font-semibold text-bark/60">Complexity:</span> {game.complexity}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-bark mb-2">Rules & Differences</h2>
      <p class="text-bark/40 mb-8">Coming from Wingspan? Here's what changed in the pocket edition.</p>
      <div class="grid md:grid-cols-2 gap-6">
        {articles.rules.map((a) => (
          <ArticleCard title={a.title} description={a.description} href={a.href} category="Rules" />
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 px-6 bg-sand/30">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-bark mb-2">Guides & Reviews</h2>
      <p class="text-bark/40 mb-8">Is the pocket edition for you? Honest buying advice.</p>
      <div class="grid md:grid-cols-2 gap-6">
        {articles.guides.map((a) => (
          <ArticleCard title={a.title} description={a.description} href={a.href} category="Guide" />
        ))}
      </div>
    </div>
  </section>

  {pocketProducts.length > 0 && (
    <section class="py-14 px-6 bg-sand/50 border-t border-bark/5">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl font-heading font-bold text-bark mb-2">Wingspan Pocket Accessories</h2>
        <p class="text-bark/40 mb-8">Made for the new compact edition — 3D-printed in Sweden.</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {pocketProducts.map((product) => <ProductCard product={product} />)}
        </div>
      </div>
    </section>
  )}

  <!-- JSON-LD Structured Data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: "Wingspan Pocket — Rules, Guides & Accessories",
      description:
        "Guides, rules explanations, and accessories for Wingspan Pocket, the 2026 compact edition of Wingspan.",
      url: "https://www.fjord-labs.com/games/wingspan-pocket/",
    })}
  />
</Base>
