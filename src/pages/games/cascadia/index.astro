---
import Base from "../../../layouts/Base.astro";
import GameBoxImage from "../../../components/GameBoxImage.astro";
import ProductCard from "../../../components/ProductCard.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import { getProductsByGame } from "../../../data/products";
import { getGame } from "../../../data/games";

const game = getGame("cascadia")!;
const cascadiaProducts = getProductsByGame("cascadia");

const articles = {
  rules: [
    {
      title: "How to Play Cascadia: Complete Rules for New Players",
      description: "Tile and token drafting, placement rules, and the two ways a turn can go wrong.",
      href: "/games/cascadia/how-to-play-cascadia/",
    },
    {
      title: "Cascadia Scoring Cards Explained: All Five Animals",
      description: "Bear pairs, elk lines, salmon runs, hawk sight lines and fox neighbours — and which card sets are hardest.",
      href: "/games/cascadia/cascadia-scoring-cards-explained/",
    },
  ],
  strategy: [
    {
      title: "Cascadia Nature Tokens: When to Spend and When to Hoard",
      description: "Each pinecone is a point — but spending one at the right moment is worth far more.",
      href: "/games/cascadia/cascadia-nature-tokens-guide/",
    },
    {
      title: "Cascadia Strategy for Beginners: Habitat Corridors vs Wildlife",
      description: "New players chase animals and lose. Here's how to balance both halves of the scoresheet.",
      href: "/games/cascadia/cascadia-beginner-strategy/",
    },
  ],
  guides: [
    {
      title: "Is Cascadia Worth It? An Honest Review",
      description: "A Spiel des Jahres winner that plays in 40 minutes. Who should actually own it?",
      href: "/games/cascadia/is-cascadia-worth-it/",
    },
  ],
};
---

<Base
  title="Cascadia — Rules, Scoring, Strategy & Accessories | Fjord Labs"
  description="Everything you need for Cascadia: complete rules, all five wildlife scoring cards explained, nature token strategy, and 3D-printed upgrades."
>
  <section class="py-16 md:py-20 px-6 bg-sand/50 border-b border-bark/5">
    <div class="max-w-4xl mx-auto">
      <nav class="flex items-center gap-2 text-sm text-bark/40 mb-6">
        <a href="/" class="hover:text-clay transition-colors">Home</a>
        <span>/</span>
        <span class="text-bark/60">Cascadia</span>
      </nav>

      <div class="flex flex-col sm:flex-row gap-6 items-start">
        <GameBoxImage game={game} />
        <div>
          <h1 class="text-3xl md:text-5xl font-heading font-bold text-bark mb-4 leading-tight">
            Cascadia
          </h1>
          <p class="text-lg text-bark/50 max-w-2xl leading-relaxed mb-6">
            {game.heroDescription}
          </p>

          <div class="flex flex-wrap gap-6 text-sm text-bark/40">
            <div><span class="font-semibold text-bark/60">Players:</span> {game.playerCount}</div>
            <div><span class="font-semibold text-bark/60">Play Time:</span> {game.playTime}</div>
            <div><span class="font-semibold text-bark/60">Complexity:</span> {game.complexity}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-bark mb-2">Rules & Scoring</h2>
      <p class="text-bark/40 mb-8">The rules fit on one page. The scoring cards are where the game actually lives.</p>
      <div class="grid md:grid-cols-2 gap-6">
        {articles.rules.map((a) => (
          <ArticleCard title={a.title} description={a.description} href={a.href} category="Rules" />
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 px-6 bg-sand/30">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-bark mb-2">Strategy</h2>
      <p class="text-bark/40 mb-8">Balancing wildlife against habitat, and getting value from your pinecones.</p>
      <div class="grid md:grid-cols-2 gap-6">
        {articles.strategy.map((a) => (
          <ArticleCard title={a.title} description={a.description} href={a.href} category="Strategy" />
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-bark mb-2">Guides & Reviews</h2>
      <p class="text-bark/40 mb-8">Buying advice and honest takes.</p>
      <div class="grid md:grid-cols-2 gap-6">
        {articles.guides.map((a) => (
          <ArticleCard title={a.title} description={a.description} href={a.href} category="Guide" />
        ))}
      </div>
    </div>
  </section>

  {cascadiaProducts.length > 0 && (
    <section class="py-14 px-6 bg-sand/50 border-t border-bark/5">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl font-heading font-bold text-bark mb-2">Cascadia Accessories</h2>
        <p class="text-bark/40 mb-8">Sculpted pinecone nature tokens and table organisation for the wildlife pool.</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {cascadiaProducts.map((product) => <ProductCard product={product} />)}
        </div>
      </div>
    </section>
  )}
</Base>
