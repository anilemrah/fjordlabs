---
// ─────────────────────────────────────────────────────────────
// QR CODE LANDING PAGE — /thanks/
//
// This URL is printed on physical QR codes shipped inside orders.
// NEVER change the file name or move this page: existing printed
// inserts would stop working. The content below is safe to edit,
// reorder, add to, or remove at any time — that's the whole point.
// ─────────────────────────────────────────────────────────────

import Base from "../layouts/Base.astro";

const workshopPhoto = "/images/workshop.jpg";
const workshopPhotoAlt =
  "A still Swedish lake reflecting the clouds, ringed by pine forest, seen from a mossy rock on the shore";

// Icons are the real app icons, copied from each app's own repo.
// Board-game apps first — that's who's scanning this code.
//   url   — omit it and the card renders un-clickable instead of as a dead link
//   badge — optional pill shown in place of the chevron ("Soon", "Web", …)
const apps = [
  {
    name: "Game Night: Party Games",
    tagline: "Party games for your table, a lot of games in one app!",
    icon: "/images/apps/game-night.png",
    url: "https://apps.apple.com/app/game-night-party-games/id6775038407",
  },
  {
    name: "Lone Meeple",
    tagline: "Solo board-gaming companion, log plays, track campaigns, beat your own scores.",
    icon: "/images/apps/lone-meeple.png",
    badge: "Soon",
  },
  {
    name: "Glimt",
    tagline: "A deck of conversation cards for you and your partner.",
    icon: "/images/apps/glimt.png",
    url: "https://apps.apple.com/app/glimt-couples-questions/id6789508959",
  },
  {
    name: "Brewio",
    tagline: "Coffee journal, brew timer and ratio calculator, we said we love coffee, right?",
    icon: "/images/apps/brewio.png",
    url: "https://apps.apple.com/app/brewio-coffee-journal-timer/id6762492301",
  },
  {
    name: "Just Pomodoro",
    tagline: "A clean, focused Pomodoro timer, we like to work efficiently!",
    icon: "/images/apps/just-pomodoro.png",
    url: "https://apps.apple.com/app/just-pomodoro-stay-focused/id1517869765",
  },
  {
    name: "ListCraft",
    tagline: "Turns a product photo into a ready-to-paste marketplace listing, the tool we built for our own shop.",
    icon: "/images/apps/listcraft.svg",
    url: "https://listcraft.co",
    badge: "Web",
  },
];
---

<Base
  title="Thanks for your order | Fjord Labs"
  description="A little more about Fjord Labs — the workshop in Sweden, our designs, our free game guides, and the apps we make."
  noindex={true}
>
  <!-- Hero -->
  <section class="px-6 pt-12 pb-10 bg-sand/50 border-b border-bark/5">
    <div class="max-w-lg mx-auto text-center">
      <img
        src="/images/fjordlabsicon.png"
        alt=""
        class="w-16 h-16 rounded-2xl mx-auto mb-5"
      />
      <p class="inline-flex items-center gap-2 px-3 py-1.5 bg-white border border-bark/10 rounded-full text-xs font-bold text-bark/60 uppercase tracking-wider mb-5">
        <img src="/images/sweden.png" alt="" class="w-4 h-4 rounded-sm" />
        <span>Made in Sweden</span>
      </p>
      <h1 class="text-3xl sm:text-4xl font-heading font-bold text-bark mb-4 leading-tight">
        Tack så mycket!
      </h1>
      <p class="text-lg text-bark/60 leading-relaxed">
        This is how we say thank you! Thank you for buying something we made. Every tray, every token is designed and
        3D-printed and packaged by us!
      </p>
    </div>
  </section>

  <!-- Where we are -->
  <section class="px-6 py-12">
    <div class="max-w-lg mx-auto">
      <img
        src={workshopPhoto}
        alt={workshopPhotoAlt}
        loading="lazy"
        class="w-full aspect-[4/3] object-cover rounded-2xl border border-bark/10 mb-6 bg-sand"
      />
      <h2 class="text-xl font-heading font-bold text-bark mb-3">
        🌲 Where your order was made
      </h2>
      <p class="text-bark/60 leading-relaxed mb-4">
        We work out of a small workshop in Sweden, near a lake and surrounded by
        forest. It's quiet, it's cold for a good part of the year, and it's a
        very good place to sit and play board games, and design things to improve them!
        We should mention a big amount of coffee as well of course!
      </p>
      <p class="text-bark/60 leading-relaxed">
        There's no factory and no warehouse. Everything starts at our own game
        table, and hopefully goes into your game table.
      </p>
    </div>
  </section>

  <!-- Designs -->
  <section class="px-6 py-12 bg-sand/30 border-y border-bark/5">
    <div class="max-w-lg mx-auto">
      <h2 class="text-xl font-heading font-bold text-bark mb-3">
        🛒 See everything else we make
      </h2>
      <p class="text-bark/60 leading-relaxed mb-6">
        Resource tokens, inserts, organisers, trackers and printable STL files, for Catan, Wingspan, Scythe, Everdell, Agricola and more.
      </p>
      <div class="flex flex-col gap-3">
        <a
          href="https://fjordlabs.etsy.com"
          target="_blank"
          rel="noopener"
          class="flex items-center justify-center gap-2 px-5 py-4 bg-clay text-white rounded-xl hover:bg-clay-dark transition-colors font-semibold"
        >
          <span>Browse our Etsy shop</span>
        </a>
        <a
          href="/products/"
          class="flex items-center justify-center gap-2 px-5 py-4 bg-white border border-bark/10 rounded-xl hover:border-clay/30 transition-colors font-semibold text-bark"
        >
          <span>See the full catalogue</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Guides -->
  <section class="px-6 py-12">
    <div class="max-w-lg mx-auto">
      <h2 class="text-xl font-heading font-bold text-bark mb-3">
        📖 Free guides for the games you play
      </h2>
      <p class="text-bark/60 leading-relaxed mb-6">
        We write rules explainers, strategy guides and setup shortcuts for the
        games we make accessories for. If a
        page settles an argument at your table, it did its job.
      </p>
      <a
        href="/games/catan/"
        class="flex items-center justify-center gap-2 px-5 py-4 bg-white border border-bark/10 rounded-xl hover:border-clay/30 transition-colors font-semibold text-bark"
      >
        <span>Read the guides</span>
      </a>
    </div>
  </section>

  <!-- Apps -->
  <section class="px-6 py-12 bg-sand/30 border-t border-bark/5">
    <div class="max-w-lg mx-auto">
      <h2 class="text-xl font-heading font-bold text-bark mb-3">
        📱 We make apps too
      </h2>
      <p class="text-bark/60 leading-relaxed mb-6">
        Board game accessories aren't the only thing we build. If any of these apps look interesting to you, consider using them. And if you ever do that, let us know what do you think!
      </p>
      <div class="flex flex-col gap-3">
        {
          apps.map((app) => {
            const Tag = app.url ? "a" : "div";
            const linkProps = app.url
              ? { href: app.url, target: "_blank", rel: "noopener" }
              : {};
            return (
              <Tag
                {...linkProps}
                class={`flex items-center gap-4 bg-white rounded-2xl border border-bark/10 p-4 transition-colors ${app.url ? "hover:border-clay/30" : ""}`}
              >
                <img
                  src={app.icon}
                  alt=""
                  loading="lazy"
                  width="56"
                  height="56"
                  class={`w-14 h-14 rounded-[22%] shrink-0 border border-bark/5 ${app.url ? "" : "opacity-60"}`}
                />
                <span class="min-w-0 flex-1">
                  <span class="block font-heading font-bold text-bark">
                    {app.name}
                  </span>
                  <span class="block text-sm text-bark/50 leading-snug">
                    {app.tagline}
                  </span>
                </span>
                {app.badge ? (
                  <span class="shrink-0 px-2.5 py-1 bg-forest/10 text-forest text-[10px] font-bold rounded-full uppercase tracking-wider">
                    {app.badge}
                  </span>
                ) : (
                  <svg
                    class="w-4 h-4 text-bark/30 shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                )}
              </Tag>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Sign-off -->
  <section class="px-6 py-14">
    <div class="max-w-lg mx-auto text-center">
      <p class="text-bark/60 leading-relaxed mb-2">
        If something arrived damaged or isn't quite right, just message us on
        Etsy, we will try to sort it out! If your package is lost or stuck in customs, let us know we will see what we can do!
      </p>
      <p class="text-bark/40 text-sm">Thanks again. Enjoy your game night. 🎲 And remember us, share your photo. Seeing one of our design on your table will make us really happy!</p>
    </div>
  </section>
</Base>
