---
import type { App } from "../data/apps";
import { hostname } from "../data/apps";

interface Props {
  app: App;
  /** Horizontal layout for a group that has only this one app. */
  wide?: boolean;
}

const { app, wide = false } = Astro.props;
const [first, second] = app.screenshots;
---

<a
  href={`/apps/${app.slug}/`}
  class={`app-card group flex flex-col ${wide ? "md:flex-row" : ""} bg-white rounded-3xl border border-bark/5 overflow-hidden hover:shadow-xl hover:border-bark/10 transition-all duration-300`}
  style={`--accent: ${app.accent}`}
>
  <div class={`tint relative h-52 overflow-hidden shrink-0 ${wide ? "md:h-auto md:w-2/5 md:min-h-[16rem]" : ""}`}>
    {
      first ? (
        <>
          <img
            src={first}
            alt=""
            loading="lazy"
            class="absolute w-28 rounded-2xl shadow-xl left-1/2 -translate-x-[95%] top-7 rotate-[-6deg] group-hover:rotate-[-3deg] transition-transform duration-300"
          />
          {second && (
            <img
              src={second}
              alt=""
              loading="lazy"
              class="absolute w-28 rounded-2xl shadow-xl left-1/2 -translate-x-[5%] top-10 rotate-[5deg] group-hover:rotate-[2deg] transition-transform duration-300"
            />
          )}
        </>
      ) : (
        <div class="absolute inset-0 flex items-center justify-center">
          <img
            src={app.icon}
            alt=""
            loading="lazy"
            class="w-28 h-28 rounded-[22%] shadow-xl group-hover:scale-105 transition-transform duration-300"
          />
        </div>
      )
    }
    {
      app.isNew && (
        <span class="absolute top-4 right-4 px-2.5 py-1 bg-clay text-white text-[11px] font-bold rounded-full shadow-sm">
          ✨ NEW
        </span>
      )
    }
  </div>

  <div class={`flex-1 flex flex-col ${wide ? "p-6 md:p-10 md:justify-center" : "p-6"}`}>
    <div class="flex items-center gap-3 mb-3">
      <img
        src={app.icon}
        alt=""
        width="48"
        height="48"
        loading="lazy"
        class="w-12 h-12 rounded-[22%] border border-bark/5 shrink-0"
      />
      <div class="min-w-0">
        <h3 class="font-heading font-bold text-bark text-lg leading-tight group-hover:text-clay transition-colors">
          {app.name}
        </h3>
        <p class="text-xs text-bark/40">{app.category}</p>
      </div>
    </div>
    <p class={`text-sm text-bark/60 leading-relaxed ${wide ? "md:text-base" : "flex-1"}`}>
      {wide ? app.intro[0] : app.tagline}
    </p>
    <div class="mt-5 pt-4 border-t border-bark/5 flex items-center justify-between gap-3 text-xs">
      <span class="text-bark/40 truncate">
        {app.website && !app.appStoreId ? hostname(app.website) : app.platform}
      </span>
      <span class="accent-text font-semibold shrink-0 inline-flex items-center gap-1">
        See the app
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  .tint {
    background:
      radial-gradient(circle at 50% 120%, color-mix(in srgb, var(--accent) 35%, transparent), transparent 70%),
      color-mix(in srgb, var(--accent) 12%, white);
  }
  .accent-text {
    color: color-mix(in srgb, var(--accent) 85%, black);
  }
</style>
