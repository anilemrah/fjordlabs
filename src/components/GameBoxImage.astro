---
import type { Game } from "../data/games";

interface Props {
  game: Game;
  size?: "sm" | "md";
}

const { game, size = "md" } = Astro.props;

const box = size === "sm" ? "w-24 h-24" : "w-32 h-32";
const wrapper = size === "sm" ? "shrink-0 hidden sm:block" : "shrink-0";
---

<div class={wrapper}>
  <img
    src={game.image}
    alt={`${game.title} box art`}
    class={`${box} rounded-2xl object-cover border border-bark/10`}
  />
  {
    game.imageCredit && (
      <p class={`${size === "sm" ? "w-32" : "w-40"} mt-2 text-[10px] leading-tight text-bark/30`}>
        {game.imageCreditUrl ? (
          <a href={game.imageCreditUrl} rel="nofollow noopener" target="_blank" class="hover:text-clay transition-colors">
            {game.imageCredit}
          </a>
        ) : (
          game.imageCredit
        )}
      </p>
    )
  }
</div>
