---
import type { Product } from "../data/products";
import { DISCOUNT_PERCENT } from "../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;

const originalPrice = product.price
  ? (parseFloat(product.price) / (1 - DISCOUNT_PERCENT / 100)).toFixed(2)
  : undefined;
---

<a
  href={`/products/${product.slug}/`}
  class="group block bg-white rounded-2xl overflow-hidden border border-bark/5 hover:border-clay/20 hover:shadow-lg hover:shadow-clay/5 transition-all duration-300"
>
  <div class="aspect-square overflow-hidden bg-sand relative">
    <img
      src={product.image}
      alt={product.title}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    {
      product.digital && (
        <span class="absolute top-3 left-3 px-2.5 py-1 bg-forest text-white text-[11px] font-bold rounded-full shadow-sm">
          ⬇ Instant Download
        </span>
      )
    }
    {
      product.isNew && (
        <span class="absolute top-3 right-3 px-2.5 py-1 bg-clay text-white text-[11px] font-bold rounded-full shadow-sm">
          ✨ NEW
        </span>
      )
    }
  </div>
  <div class="p-5">
    <span
      class="text-[11px] font-semibold text-clay uppercase tracking-wider"
    >
      {product.type}
    </span>
    <h3
      class="text-lg font-heading font-bold text-bark mt-1 group-hover:text-clay transition-colors"
    >
      {product.title}
    </h3>
    <p class="text-sm text-bark/50 mt-2 line-clamp-2">{product.description}</p>
    {
      product.price && (
        <p class="flex items-baseline gap-2 mt-3">
          <span class="text-lg font-heading font-bold text-bark">
            ${product.price}
          </span>
          {DISCOUNT_PERCENT > 0 && (
            <>
              <span class="text-sm text-bark/30 line-through">
                ${originalPrice}
              </span>
              <span class="text-[11px] font-bold text-forest">
                {DISCOUNT_PERCENT}% OFF
              </span>
            </>
          )}
        </p>
      )
    }
  </div>
</a>
