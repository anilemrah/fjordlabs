---
// Product card for the Swedish pages: Swedish name and note, the price in kronor, and a
// button straight to the Etsy listing. Photo and price come from products.ts, so they
// follow the Etsy sync; a retired slug renders nothing.
import { getProduct, priceSek } from "../data/products";

interface Props {
  slug: string;
  name: string;
  note: string;
}

const { slug, name, note } = Astro.props;
const product = getProduct(slug);
const sek = product ? priceSek(product) : undefined;
const img = product?.image.replace("il_1588xN", "il_570xN");
---

{
  product && (
    <div class="flex gap-4 items-start rounded-2xl border border-bark/10 bg-white p-4 sm:p-5">
      <a href={product.link} target="_blank" rel="noopener" class="shrink-0">
        <img src={img} alt={name} class="h-24 w-24 rounded-xl object-cover sm:h-28 sm:w-28" loading="lazy" />
      </a>
      <div class="min-w-0 flex-1">
        <p class="font-heading text-lg font-bold leading-snug text-bark">{name}</p>
        <p class="mt-1 text-bark/60">{note}</p>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          {sek && <span class="font-heading font-bold text-bark">ca {sek} kr</span>}
          <a
            href={product.link}
            target="_blank"
            rel="noopener"
            class="ml-auto inline-flex items-center gap-1.5 rounded-lg bg-clay px-3.5 py-2 text-sm font-semibold text-white hover:bg-clay-dark transition-colors"
          >
            Se på Etsy →
          </a>
        </div>
      </div>
    </div>
  )
}
